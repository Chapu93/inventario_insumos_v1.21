# Configuración de la Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventario_insumos_v1
DB_USER=root
DB_PASS=
DB_SOCKET=

# Configuración de la Aplicación
APP_BASE_URL=/inventario_app

# Entorno de la Aplicación
# Valores: production, development
APP_ENV=development

# Nivel de Logging
# Valores: DEBUG, INFO, WARNING, ERROR
# DEBUG: Todos los logs (solo en desarrollo)
# INFO: Información general
# WARNING: Advertencias importantes
# ERROR: Solo errores críticos (recomendado para producción)
LOG_LEVEL=ERROR

# Timeout de Sesión (en segundos)
# Por defecto: 3600 (1 hora)
SESSION_TIMEOUT=3600
