# Configuración de Base de Datos
DB_HOST=localhost
DB_NAME=inventario_insumos_v1
DB_USER=tu_usuario
DB_PASS=tu_contraseña
DB_PORT=3306

# Configuración de la Aplicación
# IMPORTANTE: Ajusta esta ruta según tu instalación
# Si el proyecto está en: http://tuservidor.com/inventario_app
# Entonces APP_BASE_URL debe ser: /inventario_app
# Si está en la raíz: http://tuservidor.com/
# Entonces APP_BASE_URL debe estar vacío o ser: /

APP_BASE_URL=/inventario_app

# Ejemplo para servidor en subdirectorio:
# APP_BASE_URL=/sistemas/inventario

# Ejemplo para servidor en raíz:
# APP_BASE_URL=
